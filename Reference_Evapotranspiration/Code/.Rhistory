lat = lat,
lon = lon,
n = 1,
end.year = "current",
plot = FALSE
)
## Lat & Long Mashhad Station
lat <- 36.235
lon <- 59.641
## Direct Station Code for Mashhad (Example / GSOD ID)
stations <- "407450-99999"  # یا کد معتبر ایستگاه مشهد در پایگاه داده مورد نظر شما
## Select Years
years <- 1959:2024
## Download Data
data <- GSODR::get_GSOD(years = years, station = stations)
